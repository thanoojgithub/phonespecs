echo "🚀 Running pre-push verification suite..."

if command -v node >/dev/null 2>&1; then
  node scripts/run_all_tests.js
  STATUS=$?
else
  echo "⚠️ Warning: 'node' executable not found in PATH; skipping pre-push test runner."
  exit 0
fi

if [ $STATUS -ne 0 ]; then
  echo "❌ Push rejected: Test suite failed! Please resolve violations before pushing."
  exit 1
fi

echo "✅ Pre-push tests passed. Proceeding with push."
exit 0
