echo "🚀 Running pre-push verification suite..."

NODE_CMD=""
if command -v node >/dev/null 2>&1; then
  NODE_CMD="node"
elif [ -f "/c/Users/iamth/nodejs/node-v22.14.0-win-x64/node.exe" ]; then
  NODE_CMD="/c/Users/iamth/nodejs/node-v22.14.0-win-x64/node.exe"
elif [ -f "C:\\Users\\iamth\\nodejs\\node-v22.14.0-win-x64\\node.exe" ]; then
  NODE_CMD="C:\\Users\\iamth\\nodejs\\node-v22.14.0-win-x64\\node.exe"
fi

if [ -n "$NODE_CMD" ]; then
  "$NODE_CMD" scripts/run_all_tests.js
  STATUS=$?
elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
  echo "🐳 Using Docker to execute test suite..."
  docker run --rm -v "$(pwd)":/app -w /app node:alpine node scripts/run_all_tests.js
  STATUS=$?
else
  echo "⚠️ Warning: Neither 'node' nor active Docker daemon found; skipping pre-push test runner."
  exit 0
fi

if [ $STATUS -ne 0 ]; then
  echo "❌ Push rejected: Test suite failed! Please resolve violations before pushing."
  exit 1
fi

echo "✅ Pre-push tests passed. Proceeding with push."
exit 0
