echo "🔍 Running pre-commit validation suite..."

if command -v node >/dev/null 2>&1; then
  node scripts/run_all_tests.js
  STATUS=$?
else
  echo "⚠️ Warning: 'node' executable not found in PATH; skipping pre-commit test runner."
  exit 0
fi

if [ $STATUS -ne 0 ]; then
  echo "❌ Commit aborted: Tests failed! Please fix violations before committing."
  exit 1
fi

echo "✅ Pre-commit tests passed. Proceeding with commit."
exit 0
